# DATABASE_URL is consumed by the Prisma CLI when run directly from the terminal:
#   npx prisma db push
#   npx prisma generate
#   npx prisma studio
#
# Prisma CLI resolves relative file: paths relative to the prisma/ directory
# (where schema.prisma lives), NOT relative to the project root.
#
# file:./dev.db  →  <project_root>/prisma/dev.db  ✓  (correct)
# file:./prisma/dev.db  →  <project_root>/prisma/prisma/dev.db  ✗  (wrong)
#
# The Electron runtime does NOT use this value for path resolution.
# electron/paths.ts getDatabaseUrl() is the runtime source of truth and
# always constructs an absolute path from APP_ROOT.
DATABASE_URL="file:./dev.db"
