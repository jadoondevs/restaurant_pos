# DATABASE_URL is read by the Prisma CLI (prisma db push, prisma generate, prisma studio).
# Prisma CLI resolves relative file: paths relative to the prisma/ directory
# (where schema.prisma lives), NOT relative to the project root.
# So "file:./dev.db" → <project_root>/prisma/dev.db  ✓
# NOT "file:./prisma/dev.db" which would → <project_root>/prisma/prisma/dev.db  ✗
#
# At runtime, Electron uses getDbPath() from electron/paths.ts (absolute path)
# and does NOT rely on this variable. This file is for the Prisma CLI only.
DATABASE_URL="file:./dev.db"
